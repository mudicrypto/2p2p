{
  "name": "p2p-exchange",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:migrate": "pnpm --filter @p2p/db migrate",
    "db:generate": "pnpm --filter @p2p/db generate",
    "i18n:check": "node scripts/check-i18n.mjs"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4",
    "@types/node": "^22.10.0",
    "prettier": "^3.4.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["argon2", "@swc/core", "esbuild", "msgpackr-extract", "sharp", "unrs-resolver"]
  }
}
