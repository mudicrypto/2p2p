# Copy to .env and fill in. NEVER commit real values.
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/p2p
DATABASE_REPLICA_URL=
REDIS_URL=redis://localhost:6379
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001
# 32-byte base64 master key for envelope encryption in dev. In prod use KMS_KEY_ID.
DATA_ENCRYPTION_KEY=
KMS_KEY_ID=
SESSION_SECRET=
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000
TELEGRAM_BOT_TOKEN=
# Provider selection: mock | real
PROVIDER_MODE=mock
FIREBLOCKS_API_KEY=
FIREBLOCKS_SECRET_PATH=
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
TRM_API_KEY=
POSTMARK_TOKEN=
TWILIO_SID=
TWILIO_TOKEN=
ANTHROPIC_API_KEY=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
SENTRY_DSN=
ADMIN_IP_ALLOWLIST=127.0.0.1,::1
